{
  "name": "hil-2026",
  "version": "1.0.0",
  "description": "HIL 2026 - Hockey in line (Serie A FISR & UISP) — Three.js + Phaser 3",
  "scripts": {
    "build:three": "node tools/build_three.mjs",
    "start": "npx serve . --listen 8080",
    "apk": "node deploy/android/gradle-run.js assembleDebug",
    "apk:release": "node deploy/android/gradle-run.js assembleRelease",
    "apk:install": "node deploy/android/gradle-run.js installDebug",
    "apk:clean": "node deploy/android/gradle-run.js clean",
    "ios": "node deploy/ios/xcode-run.js build",
    "ios:run": "node deploy/ios/xcode-run.js run",
    "ios:device": "node deploy/ios/xcode-run.js device",
    "ios:archive": "node deploy/ios/xcode-run.js archive",
    "ios:ipa": "node deploy/ios/xcode-run.js ipa",
    "ios:project": "node deploy/ios/xcode-run.js project",
    "ios:open": "node deploy/ios/xcode-run.js open",
    "ios:clean": "node deploy/ios/xcode-run.js clean"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "three": "0.187.0"
  }
}
